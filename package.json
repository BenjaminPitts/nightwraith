{
  "name": "nightwraith",
  "private": true,
  "type": "module",
  "description": "NightWraith official website",
  "version": "0.1.0",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^2.7.1",
    "sharp": "0.35.5",
    "vike": "0.4.268",
    "vite": "8.3.5"
  },
  "keywords": [
    "nightwraith"
  ],
  "license": "0BSD",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.4"
  },
  "scripts": {
    "build": "npm run assets && vike build",
    "postbuild": "node scripts/finalize-build.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "predev": "npm run assets",
    "dev": "vike dev",
    "develop": "npm run dev",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "start": "npm run dev",
    "serve": "vike preview",
    "clean": "node scripts/clean.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/static-build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BenjaminPitts/nightwraith"
  },
  "bugs": {
    "url": "https://github.com/BenjaminPitts/nightwraith/issues"
  }
}
